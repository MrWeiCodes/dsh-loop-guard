{
  "name": "@mrweicodes/dsh-loop-guard",
  "description": "Thinking-loop guard for dsh: observes the llm/stream waterfall and breaks a model that degrades into a loop. Detects two per-call shapes (reasoning-only calls, restated-material calls) and re-fires instead of latching; plus two mid-stream breakers that end a single degenerate call (maxRepeatedText / maxRepeatedCycleChars for visible output, maxRepeatedReasoningCycleChars for a reasoning bleed), which no post-call detector can reach — the reasoning rule is what ends the never-finishing turn of issue #5976. Ships an offline session analyzer that replays a session jsonl through the same detector. Requires dsh >=0.1.2-rc.1 <0.3.0-0, declared as engines.dsh so the runtime gate and npm's install agree.",
  "version": "1.0.12",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "icon": "./icon.svg",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./detector": {
      "types": "./lib/types/detector.d.ts",
      "default": "./lib/detector.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./src/*": "./src/*",
    "./tools/*": "./tools/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/detector.js",
    "lib/types/**/*.d.ts",
    "tools/analyze-session.mjs",
    "tools/decompress-session.mjs",
    "locale/*.json",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "README_EN.md",
    "LICENSE"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MrWeiCodes/dsh-loop-guard.git"
  },
  "homepage": "https://github.com/MrWeiCodes/dsh-loop-guard#readme",
  "bugs": {
    "url": "https://github.com/MrWeiCodes/dsh-loop-guard/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "plugin",
    "guard",
    "thinking-loop",
    "reasoning",
    "repetition",
    "circuit-breaker",
    "output-guard"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "dsh": ">=0.1.2-rc.1 <0.3.0-0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-agent": "*",
    "@deepseek-ai/dsh-llm": "*"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.5",
    "@deepseek-ai/dsh-brand": "0.2.2-rc.5",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.5",
    "@deepseek-ai/dsh-scope": "0.2.2-rc.5",
    "@deepseek-ai/dsh-session": "0.2.2-rc.5",
    "@deepseek-ai/dsh-session-projection": "0.2.2-rc.5",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-rc.5",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-rc.5",
    "@deepseek-ai/dsh-util-values": "0.2.2-rc.5",
    "@deepseek-ai/dsh-workspace": "0.2.2-rc.5",
    "semver": "^7.8.5",
    "typescript": "^5.5.0"
  },
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "test": "node --test \"test/*.spec.mjs\"",
    "analyze": "node tools/analyze-session.mjs"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    }
  }
}
